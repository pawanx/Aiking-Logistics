{
  "name": "@aiking/api",
  "version": "1.0.0",
  "private": true,
  "description": "Aiking Solutions platform API — NestJS modular monolith (spec §3.2)",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only --exit-child -r tsconfig-paths/register src/main.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only --exit-child -r tsconfig-paths/register src/worker.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "jest --config jest.unit.config.js",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:e2e": "node ../../scripts/run-e2e.mjs",
    "test:e2e:raw": "jest --config jest.e2e.config.js --runInBand",
    "test:cov": "jest --config jest.unit.config.js --coverage"
  },
  "dependencies": {
    "@aiking/shared": "*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.2",
    "bullmq": "6.3.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "ioredis": "5.9.2",
    "nodemailer": "7.0.11",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "^8.15.6",
    "@types/supertest": "6.0.3",
    "eslint": "10.9.1",
    "jest": "30.2.0",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
